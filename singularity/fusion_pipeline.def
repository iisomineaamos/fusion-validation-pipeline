Bootstrap: docker
From: ubuntu:20.04

%post
    # Set non-interactive mode for installations
    export DEBIAN_FRONTEND=noninteractive

    # Update and install base dependencies
    apt-get update && apt-get install -y \
        wget \
        build-essential \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        ca-certificates \
        r-base \
        r-base-dev

    # --- 1. Install Samtools (v1.10) ---
    wget https://github.com/samtools/samtools/releases/download/1.10/samtools-1.10.tar.bz2
    tar -xf samtools-1.10.tar.bz2
    cd samtools-1.10
    ./configure
    make
    make install
    cd ..

    # --- 2. Install Minimap2 (v2.17) ---
    wget https://github.com/lh3/minimap2/releases/download/v2.17/minimap2-2.17_x64-linux.tar.bz2
    tar -xf minimap2-2.17_x64-linux.tar.bz2
    cp minimap2-2.17_x64-linux/minimap2 /usr/local/bin/
    cp minimap2-2.17_x64-linux/k8 /usr/local/bin/
    
    # --- 3. Install R Packages ---
    # Install BiocManager first
    R -e "install.packages('BiocManager', repos='http://cran.rstudio.com/')"
    
    # Install Bioconductor packages (GenomicRanges, rtracklayer)
    R -e "BiocManager::install(c('GenomicRanges', 'rtracklayer'))"
    
    # Install CRAN packages (all the rest from your script)
    R -e "install.packages(c('tidyverse', 'optparse', 'glue', 'tidymodels', 'ranger', 'yardstick', 'vip', 'themis'), repos='http://cran.rstudio.com/')"
    
    # --- 4. Clean up ---
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf samtools-1.10.tar.bz2 samtools-1.10
    rm -rf minimap2-2.17_x64-linux.tar.bz2 minimap2-2.17_x64-linux

%environment
    # Set environment variables to prevent R locale issues
    export LANG=C.UTF-8

%runscript
    echo "Welcome to the Fusion Validation Pipeline container."
    echo "Dependencies (R, Samtools, Minimap2, R packages) are installed."
    echo ""
    echo "To run your pipeline script (e.g., 'pipeline.R'), use:"
    echo "singularity exec [options] fusion_pipeline.sif Rscript /path/to/your/pipeline.R [args]"
